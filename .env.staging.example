# ============================================================================
# SamJuniorsOS Staging Environment Configuration Template (Option A)
# ZERO SECRETS INCLUDED — Populate values securely on the staging host.
# ============================================================================

# ─── 1. CORE OS & RUNTIME ────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=http://localhost:3000
DATABASE_URL=file:/app/db/custom.db
DATABASE_MODE=authoritative
PORT=3000

# ─── 2. FOUNDER AUTHENTICATION & SECURITY GATE ───────────────────────────────
# Generate with: openssl rand -hex 32
# Server-side founder verification on privileged routes and websocket ticket signing.
SAMJUNIORS_DEV_SECRET=replace_with_staging_founder_secret_32_hex_chars
NEXT_PUBLIC_SAMJUNIORS_DEV_SECRET=

# ─── 3. MACHINE CREDENTIAL & AUTOMATION ──────────────────────────────────────
# Generate with: openssl rand -hex 32
# Authorizes automated due-work evaluation on POST /api/workflow/scheduling.
CRON_TRIGGER_SECRET=replace_with_staging_cron_trigger_secret_32_hex_chars

# ─── 4. WEBSOCKET GATEWAY & REALTIME COMPANION ───────────────────────────────
LIVE_WS_PORT=3001
LIVE_WS_TICKET_SECRET=replace_with_staging_ws_ticket_secret_32_hex_chars

# ─── 5. MULTIMODAL & COGNITIVE PROVIDERS ─────────────────────────────────────
# Staging provider API keys (optional in staging; degrades honestly to fallback if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEXT_MODEL=gemini-3.8-flash

# ─── 6. SPEECH-TO-TEXT (STT) ────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ─── 7. TEXT-TO-SPEECH (TTS) ────────────────────────────────────────────────
ELEVENLABS_API_KEY=
SOFIA_VOICE_ID=bMxLr8fP6hzNRRi9nJxU
NEXT_PUBLIC_TTS_ENGINE=gemini

# ─── 8. OPERATIONAL FLAGS ────────────────────────────────────────────────────
SAMJUNIORS_VOICE_LEGACY=0
STRICT_SINGLE_INSTANCE=1
