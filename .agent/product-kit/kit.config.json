{
  "mainBranch": "main",
  "integrationBranch": "kit/integration",
  "remote": "origin",
  "checks": [
    "npm run typecheck",
    "npm run lint"
  ],
  "ci": {
    "mode": "off",
    "timeoutMinutes": 25,
    "startWaitMinutes": 4,
    "pollSeconds": 20
  },
  "lean": {
    "maxFilesPerStep": 15,
    "maxAddedLines": 800
  },
  "secretScanIgnore": [
    "tests/sophia/m4a_memory_capture.test.ts"
  ]
}
