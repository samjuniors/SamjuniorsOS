# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# R0 secrets hygiene: runtime/generated artifacts must never be re-tracked.
# (.env is already covered by `.env*` above; listed here for clarity.)
# Local SQLite database (runtime company/conversation data)
/db/*.db
/db/*.db-journal
# Durable runtime stores (conversations, memories, audits, locks)
/.data/
# Dev-server process bookkeeping
/.zscripts/dev.pid
# Local environment (explicit; see `.env*` above)
/.env
/db/*.db-wal
/db/*.db-shm
