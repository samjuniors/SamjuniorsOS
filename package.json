{
  "name": "samjuniors-os",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:migrate:stores": "npx tsx scripts/migrate-file-stores-to-sqlite.ts",
    "db:backup": "npx tsx scripts/backup-restore.ts backup",
    "db:restore": "npx tsx scripts/backup-restore.ts restore",
    "db:reconcile-tombstones": "npx tsx scripts/reconcile-tombstones.ts",
    "test": "node scripts/test-runner.mjs",
    "test:smoke": "npx tsx tests/sophia/m1_9_smoke.test.ts",
    "benchmark:memory": "node --import tsx benchmark/memory-retrieval/verify-ci-gate.ts",
    "smoke:m1": "npx tsx tests/sophia/m1_9_smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "audit:deps": "node scripts/audit-deps.mjs",
    "scan:secrets": "gitleaks detect --config .gitleaks.toml --verbose",
    "scan:client-secrets": "node scripts/scan-client-bundle-secrets.mjs",
    "deploy:staging": "npx tsx scripts/deploy-staging.ts",
    "verify:deployment": "npx tsx scripts/verify-deployment.ts",
    "desktop:dev": "electron .",
    "desktop:pack": "vite build && electron-builder --win --dir",
    "desktop:dist": "vite build && electron-builder --win nsis",
    "eval:continuity": "npx tsx scripts/evaluate-continuity.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.7",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "framer-motion": "^12.23.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "motion": "^14.6.0",
    "next-themes": "^0.4.6",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^3.0.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.3",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "bun-types": "^1.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0"
  },
  "main": "electron/main.cjs"
}
