# SamJuniorsOS + SOFIA — environment example.
#
# Copy to .env.local (gitignored) and fill what you want.
# BLANK OR MISSING = that link is OFF — the SOFIA settings ENGINES fold and
# /api/sofia/health will say so and name the variable.
# Next.js reads .env.local at boot; in dev it reloads on change.

# ─── OS core ─────────────────────────────────────────────────────────────────
# SQLite for the OS's durable records (agents, runs, approvals). The schema
# is the sandbox SQLite port — no Postgres needed. Run `bun run db:push` once.
DATABASE_URL=file:./db/custom.db
#DATABASE_MODE=

# Multi-agent tooling (optional — the OS degrades honestly without it)
COMPOSIO_API_KEY=

# Realtime voice gateway (scripts/dev:ws, optional)
LIVE_WS_PORT=

# Founder notifications (optional)
FOUNDER_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Founder authentication gate (server-only; leave empty outside deployments)
# SECURITY: SAMJUNIORS_DEV_SECRET is a SERVER-side credential. There is no
# NEXT_PUBLIC_ twin: a secret baked into the client bundle proves nothing
# (any visitor can read it) and is treated as a security violation.
#   SAMJUNIORS_DEV_SECRET — read only by the server (production auth)
# Generate with: openssl rand -hex 32   (URL/cookie-safe)
#   - Development (NODE_ENV != production): routes are open by design
#     (single-tenant sandbox); no secret is needed.
#   - Production: every founder-gated route, the executive middleware and
#     the live WS fail closed (401) until this is provisioned. The Founder
#     then authenticates the browser via the server-validated exchange —
#     from the deployed site's devtools console (or any same-origin page):
#       await fetch('/api/auth/founder-session', { method: 'POST',
#         headers: { 'content-type': 'application/json' },
#         body: JSON.stringify({ secret: '<SAMJUNIORS_DEV_SECRET>' }) });
#     The server replies with HttpOnly cookies (JS-unreadable) that the
#     browser attaches to every request afterwards. DELETE the same URL to
#     log out. Non-browser API clients present the header pair directly:
#       x-samjuniors-dev-as: founder
#       x-samjuniors-dev-secret: <SAMJUNIORS_DEV_SECRET>
# There is NO built-in default: unset on the server means production fails
# closed (401) on every founder-gated route.
SAMJUNIORS_DEV_SECRET=

# ─── SOFIA · the brain (single provider: z-ai, built in) ─────────────────────
# The LLM is NOT a chain. R1 (honesty/consolidation) removed the never-wired
# z-ai → Gemini → local fallback ladder: every AI surface talks to the
# pre-provisioned z-ai SDK directly. There is nothing to set here, and the
# former GEMINI_API_KEY / LOCAL_LLM_* variables no longer exist.

# ─── SOFIA · the ear (STT chain: Deepgram → ElevenLabs → z-ai ASR → local) ──
# z-ai ASR: built in, no key, nothing to set.

# Link 1 — Deepgram. https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Link 2 — ElevenLabs Scribe (also enables ElevenLabs TTS below).
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# Link 4 — a local transcription server (faster-whisper / speaches / LocalAI).
LOCAL_STT_URL=
LOCAL_STT_MODEL=whisper-1
LOCAL_STT_API_KEY=

# ─── SOFIA · the voice (TTS chain: ElevenLabs → z-ai neural → local) ─────────
# z-ai neural: built in, no key. Seven voices (5 female, 2 male) in settings.

# The ElevenLabs voice to use when a key is set (only in that case).
SOFIA_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Legacy alias read by the OS's own tts routes.
JARVIS_VOICE_ID=

# Link 3 — a local speech server (kokoro-fastapi / LocalAI / openedai-speech).
LOCAL_TTS_URL=
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_sky
LOCAL_TTS_API_KEY=

# ─── SOFIA · pins — collapse a chain to one link on purpose ──────────────────
# One of: deepgram | elevenlabs | zai | local
SOFIA_STT_PROVIDER=
# One of: elevenlabs | zai | local
SOFIA_TTS_PROVIDER=
# (The JARVIS_* spellings from the bridge era still work as aliases.)
