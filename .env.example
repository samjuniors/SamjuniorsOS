# SamJuniorsOS + SOFIA — environment example.
#
# Copy to .env.local (gitignored) and fill what you want.
# BLANK OR MISSING = that link is OFF — the SOFIA settings ENGINES fold and
# /api/sofia/health will say so and name the variable.
# Next.js reads .env.local at boot; in dev it reloads on change.

# ─── OS core ─────────────────────────────────────────────────────────────────
# SQLite for the OS's durable records (agents, runs, approvals). The schema
# is the sandbox SQLite port — no Postgres needed. Run `bun run db:push` once.
DATABASE_URL=file:./db/custom.db
#DATABASE_MODE=

# Multi-agent tooling (optional — the OS degrades honestly without it)
COMPOSIO_API_KEY=

# Realtime voice gateway (scripts/dev:ws, optional)
LIVE_WS_PORT=

# Founder notifications (optional)
FOUNDER_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Founder authentication gate (server-only; leave empty outside deployments)
# SECURITY: SAMJUNIORS_DEV_SECRET is a SERVER-side credential. There is no
# NEXT_PUBLIC_ twin: a secret baked into the client bundle proves nothing
# (any visitor can read it) and is treated as a security violation.
#   SAMJUNIORS_DEV_SECRET — read only by the server (production auth)
# Generate with: openssl rand -hex 32   (URL/cookie-safe)
#   - Development (NODE_ENV != production): routes are open by design
#     (single-tenant sandbox); no secret is needed.
#   - Production: every founder-gated route, the executive middleware and
#     the live WS fail closed (401) until this is provisioned. The Founder
#     then authenticates the browser via the server-validated exchange —
#     from the deployed site's devtools console (or any same-origin page):
#       await fetch('/api/auth/founder-session', { method: 'POST',
#         headers: { 'content-type': 'application/json' },
#         body: JSON.stringify({ secret: '<SAMJUNIORS_DEV_SECRET>' }) });
#     The server replies with HttpOnly cookies (JS-unreadable) that the
#     browser attaches to every request afterwards. DELETE the same URL to
#     log out. Non-browser API clients present the header pair directly:
#       x-samjuniors-dev-as: founder
#       x-samjuniors-dev-secret: <SAMJUNIORS_DEV_SECRET>
# There is NO built-in default: unset on the server means production fails
# closed (401) on every founder-gated route.
SAMJUNIORS_DEV_SECRET=

# ─── Scheduler automation (Phase 4.4A) — machine credential ──────────────────
# The scheduler has NO in-app timer: an external trigger must POST
# /api/workflow/scheduling to wake due-work evaluation (leases, occurrence
# idempotency, wake-time re-authorization and the side-effect approval gate
# all stay enforced server-side inside WorkflowScheduler). The bundled
# mini-service (mini-services/scheduler-heartbeat) is the sandbox-local
# incarnation; a platform cron (Vercel Cron, k8s CronJob, GitHub Actions
# schedule) hitting the same endpoint with the same secret is the deployed
# equivalent.
#
# CRON_TRIGGER_SECRET is a MACHINE credential — deliberately separate from
# founder identity:
#   - authorizes ONLY due-work EVALUATION on POST /api/workflow/scheduling
#     (the executive middleware admits exactly that method+path; the route
#     re-authenticates the same secret independently);
#   - can NEVER approve work, or create/pause/resume/cancel schedules —
#     schedule lifecycle and approvals are founder-session-only;
#   - mints no identity: no session, no cookies, no role (the route reports
#     triggerSource: 'cron' honestly);
#   - fail-closed at every layer: unset here means the heartbeat service
#     refuses to start, the middleware rejects, and the route rejects.
# Generate like the founder secret (different value!): openssl rand -hex 32
# Provision it wherever SAMJUNIORS_DEV_SECRET is provisioned — it is read
# by the same server process (the executive middleware and the route).
CRON_TRIGGER_SECRET=

# Heartbeat service tuning (mini-services/scheduler-heartbeat only; a
# platform cron has its own equivalents):
#   HEARTBEAT_TARGET_URL — the scheduling endpoint to wake (default below)
#   HEARTBEAT_INTERVAL_MS — tick cadence in ms, minimum 5000 (default 60000)
#   HEARTBEAT_PORT — the operator /health port (default 3010)
HEARTBEAT_TARGET_URL=http://localhost:3000/api/workflow/scheduling
HEARTBEAT_INTERVAL_MS=60000
HEARTBEAT_PORT=3010

# ─── SOFIA · the brain (single provider: z-ai, built in) ─────────────────────
# The LLM is NOT a chain. R1 (honesty/consolidation) removed the never-wired
# z-ai → Gemini → local fallback ladder: every AI surface talks to the
# pre-provisioned z-ai SDK directly. There is nothing to set here, and the
# former GEMINI_API_KEY / LOCAL_LLM_* variables no longer exist.

# ─── SOFIA · the ear (STT chain: Deepgram → ElevenLabs → z-ai ASR → local) ──
# z-ai ASR: built in, no key, nothing to set.

# Link 1 — Deepgram. https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Link 2 — ElevenLabs Scribe (also enables ElevenLabs TTS below).
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# Link 4 — a local transcription server (faster-whisper / speaches / LocalAI).
LOCAL_STT_URL=
LOCAL_STT_MODEL=whisper-1
LOCAL_STT_API_KEY=

# ─── SOFIA · the voice (TTS chain: ElevenLabs → z-ai neural → local) ─────────
# z-ai neural: built in, no key. Seven voices (5 female, 2 male) in settings.

# The ElevenLabs voice to use when a key is set (only in that case).
SOFIA_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Legacy alias read by the OS's own tts routes.
JARVIS_VOICE_ID=

# Link 3 — a local speech server (kokoro-fastapi / LocalAI / openedai-speech).
LOCAL_TTS_URL=
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_sky
LOCAL_TTS_API_KEY=

# ─── Voice path (Phase 5 — reversible retirement of the legacy SOFIA tab) ────
# The SofiaUI-derived voice presence (voice widget + voiceRuntime on the live
# companion transport) is the default voice experience. The old SOFIA tab
# (src/sofia/**) and the routes only it consumes are retired behind this
# REVERSIBLE flag (see src/lib/server/voice-legacy.ts and
# docs/audit/PHASE5-PARITY-CHECKLIST.md):
#   SAMJUNIORS_VOICE_LEGACY=1  → the SOFIA tab and its exclusive routes
#                                behave exactly as before (full old path)
#   unset / any other value     → new voice path only; the legacy-only
#                                routes answer 410 Gone
# Authentication still fires FIRST on the retired founder-gated routes (401
# before 410 — retirement never weakens an existing control). Once the two
# Phase 5 hardware residues (live mic → streaming STT; audible playback) are
# verified on a supported machine, the documented removal set executes and
# this flag disappears.
SAMJUNIORS_VOICE_LEGACY=

# ─── SOFIA · pins — collapse a chain to one link on purpose ──────────────────
# One of: deepgram | elevenlabs | zai | local
SOFIA_STT_PROVIDER=
# One of: elevenlabs | zai | local
SOFIA_TTS_PROVIDER=
# (The JARVIS_* spellings from the bridge era still work as aliases.)
