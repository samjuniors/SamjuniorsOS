# ============================================================================
# SamJuniorsOS + SOFIA — Environment Configuration Template
# ============================================================================
# Copy this file to .env.local (gitignored) and populate variables as needed.
# Next.js reads .env.local automatically at startup.
#
# Rule: In development, optional services degrade honestly if their key is unset.
# In production, security and governance endpoints fail closed without credentials.
# ============================================================================

# ─── 1. CORE OS & DATABASE ───────────────────────────────────────────────────
# SQLite URL for the OS durable state (agents, runs, approvals, epistemic claims).
# Default local SQLite file path (run `npm run db:push` to sync schema):
DATABASE_URL=file:./db/custom.db

# Optional database mode switch ("authoritative" | "sqlite")
# DATABASE_MODE=sqlite

# Host / App URL for self-referential links, callbacks, and redirects
APP_URL=http://localhost:3000

# ─── 2. FOUNDER AUTHENTICATION & SECURITY GATE ───────────────────────────────
# SECURITY: SAMJUNIORS_DEV_SECRET is a strictly SERVER-side credential.
# It enforces fail-closed authorization on founder-gated routes and WebSocket tickets.
# Generate in terminal: openssl rand -hex 32
#   - Development (NODE_ENV != production): open sandbox default for fast iteration
#   - Production: fail-closed (401) on all executive/orchestration endpoints unless set
SAMJUNIORS_DEV_SECRET=

# Public alias for local client testing (only used in dev sandbox)
NEXT_PUBLIC_SAMJUNIORS_DEV_SECRET=

# Optional: Clerk publishable key if using Clerk auth provider
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ─── 3. SCHEDULER AUTOMATION & MACHINE CREDENTIAL ────────────────────────────
# CRON_TRIGGER_SECRET is a dedicated MACHINE credential (separate from founder identity).
# It authorizes ONLY background due-work evaluation on POST /api/workflow/scheduling.
# Generate: openssl rand -hex 32
CRON_TRIGGER_SECRET=

# Heartbeat service tuning (mini-services/scheduler-heartbeat or platform cron):
HEARTBEAT_TARGET_URL=http://localhost:3000/api/workflow/scheduling
HEARTBEAT_INTERVAL_MS=60000
HEARTBEAT_PORT=3010

# ─── 4. REALTIME COMPANION & WEBSOCKET GATEWAY ───────────────────────────────
# Port for the standalone live WebSocket companion server (run via `npm run dev:ws`)
LIVE_WS_PORT=3001

# ─── 5. MULTIMODAL & LLM PROVIDERS (SOPHIA BRAIN) ───────────────────────────
# Google Gemini API (primary multimodal, live voice streaming, and reasoning)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Pure Gemini Live All-in-One pipeline & live settings
SOPHIA_PURE_GEMINI_LIVE=true
SOPHIA_ASR_INTERRUPTION=true
SOPHIA_ALLOW_RAW_LIVE_KEY=1

# Local / Self-Hosted LLM Brain (optional fallbacks via Ollama or LM Studio)
# Brain mode: "auto" | "gemini" | "ollama" | "lmstudio"
SOPHIA_BRAIN_MODE=gemini

# Ollama local inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LM Studio local inference
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Anthropic Claude API (optional direct integration)
ANTHROPIC_API_KEY=

# ─── 6. SPEECH-TO-TEXT (STT / THE EAR) ──────────────────────────────────────
# STT Provider Chain: Deepgram -> ElevenLabs Scribe -> Browser / Local ASR

# Deepgram STT (https://console.deepgram.com)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ElevenLabs Scribe (https://elevenlabs.io)
ELEVENLABS_API_KEY=

# Local Speech-to-Text Server (faster-whisper / speaches / LocalAI)
LOCAL_STT_URL=
LOCAL_STT_MODEL=whisper-1
LOCAL_STT_API_KEY=

# Pin STT Provider explicitly: "deepgram" | "elevenlabs" | "zai" | "local"
SOFIA_STT_PROVIDER=

# ─── 7. TEXT-TO-SPEECH (TTS / THE VOICE) ────────────────────────────────────
# TTS Provider Chain: ElevenLabs -> Deepgram Aura -> Local TTS -> Web Speech API

# Voice ID for Sophia (Default Australian Female: bMxLr8fP6hzNRRi9nJxU)
SOFIA_VOICE_ID=bMxLr8fP6hzNRRi9nJxU
ELEVENLABS_VOICE_ID=bMxLr8fP6hzNRRi9nJxU
JARVIS_VOICE_ID=bMxLr8fP6hzNRRi9nJxU

# Deepgram Voice Model (e.g., aura-2-thalia-en, aura-asteria-en)
DEEPGRAM_VOICE_MODEL=aura-2-thalia-en

# Local TTS Server (kokoro-fastapi / LocalAI / openedai-speech)
LOCAL_TTS_URL=
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_sky
LOCAL_TTS_API_KEY=

# Default TTS engine ("gemini" | "elevenlabs" | "deepgram" | "system")
NEXT_PUBLIC_TTS_ENGINE=gemini

# Pin TTS Provider explicitly: "elevenlabs" | "deepgram" | "zai" | "local"
SOFIA_TTS_PROVIDER=

# ─── 8. TOOLS & EXTERNAL INTEGRATIONS ───────────────────────────────────────
# Composio Tool Integration (https://composio.dev)
COMPOSIO_API_KEY=

# Target GitHub repository for repository integration tools (owner/repo)
GITHUB_REPOSITORY=samjuniors/SamjuniorsOS

# Resend Email Integration (https://resend.com)
FOUNDER_EMAILS=founder@samjuniors.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@samjuniors.com
RESEND_WEBHOOK_SECRET=

# ─── 9. OPERATIONAL FLAGS ────────────────────────────────────────────────────
# Legacy Server Voice Routes: 1 = legacy fallback enabled, 0 = 410 Gone (retired)
SAMJUNIORS_VOICE_LEGACY=0

# Single instance enforcement lock
STRICT_SINGLE_INSTANCE=0
