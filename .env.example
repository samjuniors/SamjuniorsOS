# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# COMPOSIO_API_KEY: Optional API key for Composio tool integration (server-side only).
COMPOSIO_API_KEY=

# RESEND_API_KEY: API key for Resend email provider (server-side only).
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Default from email for transactional / approved automated emails.
RESEND_FROM_EMAIL="contact@samjuniors.com"

# RESEND_WEBHOOK_SECRET: Optional secret for validating incoming Resend Svix webhooks (server-side only).
RESEND_WEBHOOK_SECRET=

# DATABASE_URL: PostgreSQL connection string for pooled connections (e.g. Supabase connection pooler / PgBouncer or Cloud SQL).
# In production, use transaction mode pooler port (e.g. 6543) or Cloud SQL socket.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samjuniors_os?schema=public"

# DIRECT_URL: Direct unpooled PostgreSQL connection string for Prisma schema migrations and DDL operations.
# Connects directly to PostgreSQL (port 5432) to bypass connection poolers that do not support prepared statements/DDL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/samjuniors_os?schema=public"
